{
  "name": "@steimerbyte/agent-ssh-tools",
  "version": "0.10.0",
  "description": "Pi/omp SSH extension with agent-safety: probe-before-activate, verify block, profile+alias resolver, SHA-256 unchanged-detection.",
  "keywords": [
    "pi",
    "pi-extension",
    "omp",
    "omp-extension",
    "ssh",
    "agent",
    "devops",
    "remote-execution"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./extensions/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@oh-my-pi/pi-coding-agent": "^18.1.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/pi-coding-agent": ">=18.1.2",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "@oh-my-pi/pi-coding-agent": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steimerbyte/agent-ssh-tools.git"
  },
  "bugs": {
    "url": "https://github.com/steimerbyte/agent-ssh-tools/issues"
  },
  "homepage": "https://github.com/steimerbyte/agent-ssh-tools#readme",
  "author": "Benjamin Steimer",
  "publishConfig": {
    "access": "public"
  }
}
